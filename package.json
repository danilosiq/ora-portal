{
  "name": "ora-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fullcheck": "yarn check:package-manager && yarn check:architecture && yarn format:check && yarn typecheck && yarn test:coverage && yarn build",
    "format": "prettier --write src scripts components.json tsconfig.json next.config.ts tests JestConfig.mjs package.json .yarnrc.yml",
    "format:check": "prettier --check src scripts components.json tsconfig.json next.config.ts tests JestConfig.mjs package.json .yarnrc.yml",
    "check:architecture": "node scripts/CheckArchitecture.mjs",
    "test": "jest --config JestConfig.mjs --runInBand",
    "test:watch": "jest --config JestConfig.mjs --watch",
    "test:coverage": "yarn test --coverage",
    "preinstall": "node scripts/CheckPackageManager.mjs",
    "check:package-manager": "node scripts/CheckPackageManager.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.18.1"
}
